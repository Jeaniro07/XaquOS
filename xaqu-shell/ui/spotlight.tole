// Xaqu's Spotlight (SUPER Space): the query line over the desktop's top,
// and the rows under it, in the glass. Rust holds the query, the rows and
// the one chosen (`src/spotlight.rs`); this draws them and says what was
// typed.
import Fx

struct HitRow {
    icon: string
    letter: string
    text: string
    detail: string
    on: bool
}

export component Spotlight : FocusScope {
    id: spot
    property string query
    property real cardW
    property real cardH
    property list<HitRow> rows
    property string icSearch

    signal typed(string text)
    signal backspaced()
    signal entered()
    signal stepped(int down)
    signal dismissed()
    signal run(int index)

    focus: true
    Keys.onPressed: { if (event.text != "") { event.accepted = true; spot.typed(event.text) } }
    Keys.onBackPressed: spot.backspaced()
    Keys.onReturnPressed: spot.entered()
    Keys.onEnterPressed: spot.entered()
    Keys.onEscapePressed: spot.dismissed()
    Keys.onUpPressed: spot.stepped(0)
    Keys.onDownPressed: spot.stepped(1)

    // A press off the card goes away, keeping what was typed.
    MouseArea {
        anchors.fill: parent
        onClicked: spot.dismissed()
    }

    Rectangle {
        x: (spot.width - spot.cardW) / 2
        y: 60
        width: spot.cardW
        height: spot.cardH
        radius: 14
        color: alpha(Nocturne.bg, 0.86)
        border.width: 1
        border.color: Nocturne.n800
        MouseArea { anchors.fill: parent }

        // The query line.
        Row {
            x: 16
            spacing: 10
            Text {
                height: 56
                text: spot.icSearch
                font: Nocturne.icon(16)
                color: Nocturne.a200
            }
            Text {
                height: 56
                text: spot.query == "" ? "Search apps, windows, files, sums" : spot.query
                font: Nocturne.sans(16, 500)
                color: spot.query == "" ? Nocturne.n500 : Nocturne.text
            }
        }

        // The rows, best first, the chosen one lit.
        Column {
            y: 56
            width: spot.cardW
            Repeater {
                model: spot.rows
                Item {
                    width: spot.cardW
                    height: 44
                    Rectangle {
                        visible: modelData.on
                        x: 6; y: 2
                        width: spot.cardW - 12
                        height: 40
                        radius: 10
                        color: alpha(Nocturne.accent, 0.18)
                    }
                    Rectangle {
                        x: 14; y: 8
                        width: 28; height: 28
                        radius: 7
                        color: modelData.icon == "" ? alpha(Nocturne.n700, 0.8) : "transparent"
                        Text {
                            anchors.centerIn: parent
                            text: modelData.icon == "" ? modelData.letter : modelData.icon
                            font: Nocturne.icon(modelData.icon == "" ? 15 : 16)
                            color: Nocturne.a200
                        }
                    }
                    Text {
                        x: 54; y: 7
                        width: spot.cardW - 170
                        text: modelData.text
                        elide: Text.ElideRight
                        font: Nocturne.sans(14, 500)
                        color: Nocturne.text
                    }
                    Text {
                        x: 54; y: 26
                        width: spot.cardW - 170
                        text: modelData.detail
                        elide: Text.ElideRight
                        font: Nocturne.sans(11, 400)
                        color: Nocturne.n500
                    }
                    MouseArea {
                        x: 6; y: 2
                        width: spot.cardW - 12
                        height: 40
                        cursorShape: Qt.PointingHandCursor
                        onClicked: spot.run(index)
                    }
                }
            }
        }
    }
}
